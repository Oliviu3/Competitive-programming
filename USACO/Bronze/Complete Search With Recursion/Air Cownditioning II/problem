#include <bits/stdc++.h>
using namespace std;
int n,m;
int stalls[101]={0};
vector<vector<int> > cond;
vector<int> ex;
void freezing(int k,int &s1,int s)
{
    if(k==m)
    {
        int g=0,i=1;
        for(int i=1;i<101;i++)
        {
            if(stalls[i]<0)
                g++;

        }

        if(g==0 && s<s1)
        s1=s;
    }
    else
    {
        freezing(k+1,s1,s);
        for(int i=cond[k][0];i<=cond[k][1];i++)
        {
            stalls[i]+=cond[k][2];
        }
        s+=cond[k][3];
        freezing(k+1,s1,s);
        for(int i=cond[k][0];i<=cond[k][1];i++)
        {
            stalls[i]-=cond[k][2];
        }
        s-=cond[k][3];
    }
}
int main()
{
    int x,y,z,s1=9999999;
   cin>>n>>m;
    cond.resize(m,vector<int>(4,0));
    ex.resize(m,1);
   for(int i=0;i<n;i++)
   {
       cin>>x>>y>>z;
       for(int j=x;j<=y;j++)
       {
           stalls[j]-=z;
       }
   }
    for(int i=0;i<m;i++)
    {
        for(int j=0;j<4;j++)
        {
            cin>>cond[i][j];
        }
    }
    freezing(0,s1,0);
    cout<<s1;
}
