#include <bits/stdc++.h>

using namespace std;
ifstream fin("backforth.in");
ofstream fout("backforth.out");
vector<bool> ver(2001,0);
int s=0;
void problem (int day,int barn,vector<pair<int,int>> buc)
{
    if(day==4)
    {
         if(!ver[barn])
         {
            ver[barn]=1;
             s++;
         }
         return;
    }
   for(int i=0;i<20;i++)
   {
       if(day%2==0)
       {
          if(buc[i].second==0)
          {
              buc[i].second=1;
              problem(day+1,barn-buc[i].first,buc);
              buc[i].second=0;
          }
          else
            continue;
       }
       else
       {
           if(buc[i].second==1)
          {
              buc[i].second=0;
              problem(day+1,barn+buc[i].first,buc);
              buc[i].second=1;
          }
          else
            continue;
       }
   }
}
int main()
{

   vector<pair<int,int>> buc(20);

   for(int i=0;i<20;i++)
   {
       if(i<10)
       {
       fin>>buc[i].first;
           buc[i].second=0;
       }
       else
       {
        fin>>buc[i].first;
           buc[i].second=1;
       }
   }
    problem(0,1000,buc);
    fout<<s;
}
