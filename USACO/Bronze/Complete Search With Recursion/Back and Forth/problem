#include <bits/stdc++.h>

using namespace std;
ifstream fin("backforth.in");
ofstream fout("backforth.out");
vector<bool> ver(3000,0);
int s=0;
void problem (int day,int barn,vector<int> first,vector<int> second)
{
    if(day==4)
    {
         if(!ver[barn]);
         {
            ver[barn]==1;
             s++;
         }

    }
    if(day%2==0)
    {
        for(int i=0;i<10;i++)
        {
            barn-=first[i];
             problem(day+1,barn,first,second);
            barn+=first[i];
            day--;
        }
    }
    else
    {
      for(int i=0;i<10;i++)
        {
            barn+=first[i];
             problem(day+1,barn,first,second);
            barn-=first[i];
        }
    }
}
int main()
{
    int firstb=1000;
   vector<int> first(10);
   vector<int> second(10);
   for(int i=0;i<10;i++)
   {
       fin>>first[i];
   }
   for(int i=0;i<10;i++)
   {
       fin>>second[i];
   }
    problem(0,firstb,first,second);
    fout<<s;
}
