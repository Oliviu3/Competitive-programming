#include<iostream>
#include <vector>
#include<algorithm>
using namespace std;


int main()
{
    int n,m=1000;
    cin>>n;
    vector<int> a(n);
    vector<char> b(n);
    int m1=0;
    for(int i=0;i<n;i++)
    {
        cin>>b[i]>>a[i];
    }
    m1=0;
    for(int i=0;i<n;i++)
    {
        m1=0;
        int c=a[i];
       for (int j=0;j<n;j++)
       {
           if(b[j]=='L' && c>a[j])
           {
               m1++;
           }
           if(b[j]=='G' && c<a[j])
           {
               m1++;
           }
       }
        m=min(m,m1);
    }
    if(m!=1000)
        cout<<m;
    else
        cout<<0;
}
