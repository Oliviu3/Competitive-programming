#include<iostream>
#include <vector>
using namespace std;


int main()
{
    int n;
    vector<int> a,b;

    cin>>n;
    vector<int> d(n+1,0);
    for(int i=0;i<n;i++)
    {
        int c;
        cin>>c;
        a.push_back(c);
    }
    for(int i=0;i<n;i++)
    {
        int c;
        cin>>c;
        b.push_back(c);
    }
    int c=0;
    for(int i=0;i<n;i++)
    {
        if(a[i]==b[i])
        {
            c++;
        }
    }

        for (int i=0;i<n;i++)
        {
            int left=i;
            int right=i;
            int r=0;
            while (left>=0 && right<n)
            {
                if (a[left]==b[right])
                    r++;

                if (a[right]==b[left])
                    r++;

                if (a[left]==b[left])
                    r--;

                if (a[right]==b[right])
                    r--;
                d[c+r]++;
                left--;
                right++;
            }
        }
    for (int i=0;i<n-1;i++)
    {
        int left=i;
        int right=i+1;
        int r=0;
        while (left>=0 && right<n)
        {
            if (a[left]==b[right])
                r++;

            if (a[right]==b[left])
                r++;

            if (a[left]==b[left])
                r--;

            if (a[right]==b[right])
                r--;
            d[c+r]++;
            left--;
            right++;
        }
    }
    for(int i=0;i<n+1;i++)
    {
        cout<<d[i]<<"\n";
    }
}
